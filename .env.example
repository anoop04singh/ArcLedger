# Demo is deliberately explicit and never connects to Mainnet.
ARCLEDGER_MODE=demo
ARC_RPC_URL=https://rpc.mainnet.arc.io
DATABASE_URL=postgresql://arcledger:arcledger@localhost:5432/arcledger
API_PORT=3001
API_URL=http://127.0.0.1:3001
# Choose the start of your coverage deliberately. Totals cover indexed blocks only.
INDEXER_START_BLOCK=0
INDEXER_POLL_MS=2000
