# Demo is explicit and does not run the indexer.
ARCLEDGER_MODE=demo
PRIMARY_RPC_URL=https://rpc.mainnet.arc.io
# Optional independent provider. Each endpoint is verified as Arc Mainnet before use.
FALLBACK_RPC_URL=https://rpc.drpc.mainnet.arc.io
DATABASE_URL=postgresql://arcledger:arcledger@localhost:5432/arcledger
API_PORT=3001
API_URL=http://127.0.0.1:3001
# Empty starts at the current committed head. Set a block number for backfill.
# A persisted checkpoint always takes precedence on restart.
INDEX_START_BLOCK=
INDEXER_POLL_MS=250
INDEXER_RETRY_MS=1000
INDEXER_BLOCK_PREFETCH=4
INDEXER_TX_CONCURRENCY=32

# Per socket IP, per minute; public read endpoints only.
API_RATE_LIMIT=120

# Supabase: copy the Session Pooler URL (5432) from Connect; do not use 6543.
# Remote PostgreSQL always verifies TLS. Download the CA from Database settings if required.
DATABASE_POOL_MAX=5
# DATABASE_SSL_CA_FILE=C:/path/to/prod-supabase.cer
# ARC_RPC_URL and ARC_FALLBACK_RPC_URL are accepted aliases for PRIMARY_RPC_URL / FALLBACK_RPC_URL.
# NEXT_PUBLIC_API_URL is optional; API_URL is preferred for the server-side UI relay.
# No Supabase SDK or secret API key is required. Never put database credentials in NEXT_PUBLIC_ variables.

# Railway: complete multiline PEM CA contents instead of a local Windows path.
# DATABASE_SSL_CA=
# API binding on Railway: HOST=:: and PORT=3001. Web: PORT=3000.
# Validation defaults to the latest five complete raw blocks; optional range (max 1000).
# VALIDATION_START_BLOCK=
# VALIDATION_END_BLOCK=
